# Git stores text files with LF and checks them out with the line endings below,
# whatever core.autocrlf says. Keep these in step with .editorconfig.
* text=auto eol=lf

# Visual Studio writes project and solution files with CRLF.
*.csproj text eol=crlf
*.props  text eol=crlf
*.sln    text eol=crlf

*.png binary
